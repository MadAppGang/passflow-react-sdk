{
  "name": "@passflow/react",
  "description": "Passflow React UI Kit",
  "version": "0.14.0",
  "type": "module",
  "files": ["dist", "CHANGELOG.md"],
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.cjs.js"
      }
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepack": "pnpm build",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "preview": "vite preview",
    "test": "playwright install chromium && playwright test --config=playwright/playwright.config.ts",
    "test:ui": "playwright install chromium && playwright test --config=playwright/playwright.ui.config.ts --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@passflow/core": "^0.20.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "clsx": "^2.1.1",
    "countries-and-timezones": "^3.11.0",
    "dayjs": "^1.11.23",
    "input-otp": "^1.5.0",
    "lodash": "^4.18.1",
    "phone": "^3.1.72",
    "query-string": "^10.0.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-international-phone": "^4.8.0",
    "tailwind-merge": "^3.7.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cssnano": "^9.9.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "storybook": "10.6.5",
    "terser": "^5.51.2",
    "tsc-alias": "^1.9.9",
    "typescript": "5.8.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-environment": "^1.1.4",
    "vitest": "^5.0.5"
  },
  "authors": [
    {
      "name": "Ivan Holiak",
      "url": "https://github.com/IvanHoliak"
    },
    {
      "name": "Jack Rudenko",
      "url": "https://madappgang.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MadAppGang/passflow-react-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadAppGang/passflow-react-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "passflow",
    "auth",
    "authentication",
    "passwordless",
    "session",
    "jwt",
    "react",
    "ui",
    "ui-kit",
    "react-ui-kit",
    "passflow-react-ui-kit"
  ],
  "packageManager": "pnpm@12.16.1"
}
