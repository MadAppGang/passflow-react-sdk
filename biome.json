{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noDuplicateProperties": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noUselessElse": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "warn",
        "noComponentHookFactories": "warn"
      },
      "complexity": {
        "noForEach": "warn",
        "noUselessContinue": "warn"
      },
      "a11y": {
        "noAutofocus": "off",
        "useSemanticElements": "off",
        "useAriaPropsSupportedByRole": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "warn"
          }
        }
      }
    }
  ],
  "files": {
    "includes": ["**", "!**/*.d.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 128
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
